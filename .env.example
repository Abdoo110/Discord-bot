# Bot Token (from Discord Developer Portal)
TOKEN=your_bot_token_here

# Bot Client ID
CLIENT_ID=your_client_id_here

# MongoDB Connection String (MongoDB Atlas free tier recommended)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/discord-bot

# Bot Invite Link (set after creating bot)
BOT_INVITE=your_bot_invite_link_here
